<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.lucienrowan.financemanager.gui.NewIteration">
  <grid id="27dc6" binding="newIterationPanel" layout-manager="GridLayoutManager" row-count="3" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="500" height="245"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="ce918" class="javax.swing.JSpinner" binding="sbYear">
        <constraints>
          <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="8c347" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Time Period"/>
        </properties>
      </component>
      <component id="9440d" class="javax.swing.JComboBox" binding="cbMonth">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="January"/>
            <item value="February"/>
            <item value="March"/>
            <item value="April"/>
            <item value="May"/>
            <item value="June"/>
            <item value="July"/>
            <item value="August"/>
            <item value="September"/>
            <item value="October"/>
            <item value="November"/>
            <item value="December"/>
          </model>
        </properties>
      </component>
      <component id="8d694" class="javax.swing.JButton" binding="btnCancel">
        <constraints>
          <grid row="1" column="3" row-span="2" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Cancel"/>
        </properties>
      </component>
      <component id="fd1d5" class="javax.swing.JButton" binding="btnSave">
        <constraints>
          <grid row="1" column="2" row-span="2" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Save"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
